<?xml version="1.0" encoding="utf-8"?>
<skin>
  <information>
    <name>DevLog</name>
    <version>1.0.0</version>
    <description>
      <![CDATA[개발 블로그를 위한 2단(왼쪽 사이드바) 스킨. 다크 모드, 자동 목차, 코드 하이라이트·복사 버튼, 읽기 진행바를 지원합니다.]]>
    </description>
    <license>
      <![CDATA[사용과 수정은 자유입니다. 대신 출처는 남겨주세요. 재배포, 판매 금지입니다.]]>
    </license>
  </information>
  <author>
    <name>Noahchoi</name>
    <homepage>https://github.com/chtj1024/devlog-skin</homepage>
    <email></email>
  </author>
  <default>
    <recentEntries>5</recentEntries>
    <recentComments>5</recentComments>
    <recentTrackbacks>5</recentTrackbacks>
    <itemsOnGuestbook>10</itemsOnGuestbook>
    <tagsInCloud>20</tagsInCloud>
    <sortInCloud>1</sortInCloud>
    <expandComment>1</expandComment>
    <expandTrackback>0</expandTrackback>
    <lengthOfRecentNotice>30</lengthOfRecentNotice>
    <lengthOfRecentEntry>40</lengthOfRecentEntry>
    <lengthOfRecentComment>30</lengthOfRecentComment>
    <lengthOfRecentTrackback>30</lengthOfRecentTrackback>
    <lengthOfLink>30</lengthOfLink>
    <showListOnCategory>1</showListOnCategory>
    <showListOnArchive>1</showListOnArchive>
    <showListOnTag>1</showListOnTag>
    <showListOnSearch>1</showListOnSearch>
    <commentMessage>
      <none><![CDATA[]]></none>
      <single><![CDATA[1]]></single>
    </commentMessage>
    <trackbackMessage>
      <none><![CDATA[]]></none>
      <single><![CDATA[]]></single>
    </trackbackMessage>
    <tree>
      <color>1f2328</color>
      <bgColor>ffffff</bgColor>
      <activeColor>3182f6</activeColor>
      <activeBgColor>ffffff</activeBgColor>
      <labelLength>30</labelLength>
      <showValue>1</showValue>
    </tree>
    <contentWidth>760</contentWidth>
    <entriesOnPage>10</entriesOnPage>
    <entriesOnList>10</entriesOnList>
  </default>

  <variables>
    <variablegroup name="디자인">
      <variable>
        <name>accent-color</name>
        <label><![CDATA[포인트 색상]]></label>
        <description><![CDATA[링크, 카테고리, 목차 강조 등에 쓰이는 대표 색입니다.]]></description>
        <type>COLOR</type>
        <option />
        <default><![CDATA[#3182f6]]></default>
      </variable>
      <variable>
        <name>font</name>
        <label><![CDATA[본문 글꼴]]></label>
        <type>SELECT</type>
        <option><![CDATA[
          [
            {"name":"pretendard", "label":"Pretendard", "value":"pretendard"},
            {"name":"noto", "label":"Noto Sans KR", "value":"noto"},
            {"name":"system", "label":"시스템 기본 글꼴", "value":"system"}
          ]
        ]]></option>
        <default>pretendard</default>
      </variable>
    </variablegroup>

    <variablegroup name="글 화면">
      <variable>
        <name>show-toc</name>
        <label><![CDATA[목차 리모컨]]></label>
        <description><![CDATA[본문의 제목1~3으로 목차를 만들어 오른쪽에 리모컨으로 띄웁니다. 맨 위/댓글/맨 아래 이동 버튼이 함께 표시됩니다.]]></description>
        <type>BOOL</type>
        <option />
        <default>true</default>
      </variable>
      <variable>
        <name>code-highlight</name>
        <label><![CDATA[코드 하이라이트]]></label>
        <description><![CDATA[highlight.js로 코드블록에 색을 입힙니다.]]></description>
        <type>BOOL</type>
        <option />
        <default>true</default>
      </variable>
      <variable>
        <name>show-progress</name>
        <label><![CDATA[읽기 진행바]]></label>
        <type>BOOL</type>
        <option />
        <default>true</default>
      </variable>
    </variablegroup>

    <variablegroup name="홈 화면">
      <variable>
        <name>show-hero</name>
        <label><![CDATA[소개 영역]]></label>
        <description><![CDATA[홈 커버를 사용할 때 맨 위에 블로그 소개 영역을 표시합니다.]]></description>
        <type>BOOL</type>
        <option />
        <default>true</default>
      </variable>
      <variable>
        <name>hero-desc</name>
        <label><![CDATA[소개 문구]]></label>
        <type>STRING</type>
        <option />
        <default><![CDATA[IT 전반에 대해 공부하며 배운 것과 삽질한 것을 기록하고 있어요.]]></default>
      </variable>
      <variable>
        <name>hero-tags</name>
        <label><![CDATA[소개 태그]]></label>
        <description><![CDATA[쉼표(,)로 구분해 입력합니다. 예: React, Spring, AI · LLM]]></description>
        <type>STRING</type>
        <option />
        <default><![CDATA[React, TypeScript, Spring, Java, Python, AI · LLM, Algorithm, Database, Network, OS, Cloud, DevOps, Git, Security]]></default>
      </variable>
      <variable>
        <name>show-home-tags</name>
        <label><![CDATA[태그 모음]]></label>
        <description><![CDATA[홈 커버 맨 아래에 태그 모음을 표시합니다.]]></description>
        <type>BOOL</type>
        <option />
        <default>true</default>
      </variable>
    </variablegroup>

    <variablegroup name="프로필">
      <variable>
        <name>github-url</name>
        <label><![CDATA[GitHub 주소]]></label>
        <description><![CDATA[예: https://github.com/username (비워두면 숨김)]]></description>
        <type>STRING</type>
        <option />
        <default></default>
      </variable>
      <variable>
        <name>linkedin-url</name>
        <label><![CDATA[LinkedIn 주소]]></label>
        <type>STRING</type>
        <option />
        <default></default>
      </variable>
      <variable>
        <name>email</name>
        <label><![CDATA[이메일]]></label>
        <type>STRING</type>
        <option />
        <default></default>
      </variable>
      <variable>
        <name>footer-text</name>
        <label><![CDATA[푸터 문구]]></label>
        <description><![CDATA[비워두면 "© 필명"이 표시됩니다.]]></description>
        <type>STRING</type>
        <option />
        <default></default>
      </variable>
    </variablegroup>
  </variables>

  <cover>
    <item>
      <name>featured</name>
      <label><![CDATA[추천 글]]></label>
      <description><![CDATA[첫 번째 글을 크게, 나머지 글(2~3개 권장)을 옆에 작게 보여줍니다.]]></description>
    </item>
    <item>
      <name>catbox</name>
      <label><![CDATA[카테고리 박스]]></label>
      <description><![CDATA[글 제목과 날짜만 담은 박스입니다. 연달아 추가하면 두 개씩 나란히 배치됩니다.]]></description>
    </item>
    <item>
      <name>grid</name>
      <label><![CDATA[썸네일 그리드]]></label>
      <description><![CDATA[썸네일 카드를 3열 격자로 보여줍니다. 3의 배수 개수를 권장합니다.]]></description>
    </item>
  </cover>
</skin>
